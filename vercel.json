{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "master": true,
      "develop": true
    }
  },
  "crons": [
    {
      "path": "/api/discord/daily-season-update",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/daily-top-players",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/support-ask-update",
      "schedule": "0 17 * * *"
    }
  ]
}
