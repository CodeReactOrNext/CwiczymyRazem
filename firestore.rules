rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {

      // User can read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // User can write their own document, but cannot change role, support or stripe fields
      allow write: if request.auth != null
        && request.auth.uid == userId
        && !("role"                 in request.resource.data.diff(resource.data).affectedKeys())
        && !("isSupport"            in request.resource.data.diff(resource.data).affectedKeys())
        && !("supportTitle"         in request.resource.data.diff(resource.data).affectedKeys())
        && !("supportTotal"         in request.resource.data.diff(resource.data).affectedKeys())
        && !("supporterTokens"      in request.resource.data.diff(resource.data).affectedKeys())
        && !("communityGoalClaims"  in request.resource.data.diff(resource.data).affectedKeys())
        // Which rewards have been collected — badges and finished scale trees
        // alike — and how many free cases are unspent. Paid out by
        // /api/rewards/* and spent by /api/arsenal/open-case (Admin SDK). A
        // client able to write here could re-collect something it has already
        // been paid for, or mint itself free Elite cases outright.
        && !("rewards"              in request.resource.data.diff(resource.data).affectedKeys())
        && !("guildId"              in request.resource.data.diff(resource.data).affectedKeys())
        // Denormalised copy of the guild's tag and cosmetics, so the leaderboard
        // can draw a member's badge without reading /guilds (which is closed to
        // clients). Server-written for the same reason guildId is: a client able
        // to set it could wear any guild's tag, or one it was never let into.
        && !("guildBadge"           in request.resource.data.diff(resource.data).affectedKeys())
        && !("stripeCustomerId"     in request.resource.data.diff(resource.data).affectedKeys())
        && !("stripeSubscriptionId" in request.resource.data.diff(resource.data).affectedKeys())
        && !("premiumUntil"         in request.resource.data.diff(resource.data).affectedKeys());

      // role / stripe fields are written only by the backend (Firebase Admin SDK)
      // Admin SDK bypasses these rules entirely — no extra rule needed

      // Uploaded Guitar Pro files (gp-tabs library) — owner only
      match /gpFiles/{fileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Folders organizing the gp-tabs library — owner only
      match /gpFolders/{folderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Per-song practice progress (play time, sessions, accuracy, attached GP
      // file, marked parts: riff / solo / whole song) — owner only
      match /songProgress/{songId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Per-song user metadata (sections, practice notes, YouTube link) — owner only
      match /userSongs/{songId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Daily submission counters (e.g. community section-map sharing) — the
      // owner may read their own counter, but only the backend (Admin SDK)
      // may write it, otherwise a client could reset its own rate limit.
    
    }

    // ─── Exercise plans ───────────────────────────────────────────────────────
    match /exercisePlans/{planId} {
      // Owner can always read; any auth'd user can read public plans
      allow read:   if request.auth != null
        && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ─── Practice sessions ────────────────────────────────────────────────────
    match /practiceSessions/{sessionId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ─── Daily quests ─────────────────────────────────────────────────────────
    match /dailyQuests/{questId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ─── Getting-started checklist (dashboard onboarding quest) ─────────────────
    match /onboardingQuests/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ─── Community exercises ──────────────────────────────────────────────────
    match /communityExercises/{exerciseId} {
      // Public exercises are readable by anyone logged in; private only by their author
      allow read: if request.auth != null
        && (resource.data.isPublic == true || resource.data.authorId == request.auth.uid);

      // Only the author can create; authorId must match uid
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;

      // Author can update their own exercise (but cannot change authorId).
      // Any signed-in user may update ONLY the rating aggregate fields, so
      // people can rate exercises they don't own (rateExercise writes the new
      // average/count onto the exercise doc inside its transaction). Any
      // signed-in user may also bump playCount by starting the exercise —
      // it's a low-stakes, self-serve counter (unlike thanksCount, which
      // gates a fame reward and is only written by the backend below).
      allow update: if request.auth != null && (
        (
          resource.data.authorId == request.auth.uid
          && !("authorId" in request.resource.data.diff(resource.data).affectedKeys())
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'ratingCount'])
          && request.resource.data.averageRating is number
          && request.resource.data.averageRating >= 0
          && request.resource.data.averageRating <= 5
          && request.resource.data.ratingCount is int
          && request.resource.data.ratingCount >= 0
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount'])
          && request.resource.data.playCount is int
          && request.resource.data.playCount >= 0
        )
      );

      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      // Ratings subcollection — each user writes only their own rating
      match /ratings/{userId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Thanks subcollection — awards the author fame, so it's only ever
      // written by the backend (Admin SDK, see /api/community-exercises/thank),
      // which also bypasses the read rule below. Clients may only read it,
      // e.g. to show whether the current user already thanked the exercise.
      match /thanks/{userId} {
        allow read:  if request.auth != null;
        allow write: if false;
      }

      // Completions subcollection — dedupes the "first completion" fame
      // reward (see /api/community-exercises/complete). Backend-only, same
      // reasoning as thanks above.
      match /completions/{userId} {
        allow read:  if request.auth != null;
        allow write: if false;
      }
    }

    // ─── Song playlists ───────────────────────────────────────────────────────
    match /playlists/{playlistId} {
      // Owner can always read; any auth'd user can read public playlists
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true);

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      // Owner edits their playlist (ownerId immutable). Any signed-in user may
      // update ONLY the popularity fields (importCount / likeCount / likes) on a
      // public playlist — written when they save (copy) or like it.
      allow update: if request.auth != null && (
        (
          resource.data.ownerId == request.auth.uid
          && !("ownerId" in request.resource.data.diff(resource.data).affectedKeys())
        )
        || (
          resource.data.isPublic == true
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['importCount', 'likeCount', 'likes'])
        )
      );

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // ─── Activity feed logs ───────────────────────────────────────────────────
    // Any signed-in user reads the feed, and a user may append their own activity
    // (the client writes these as they practise, add songs, open cases…).
    // Updates are backend-only: the only client-facing mutation is a reaction,
    // which grants the recipient Fame, so it runs through /api/logs/react (Admin
    // SDK) where the amount is derived server-side instead of being sent in.
    match /logs/{logId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && (!("uid" in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow update, delete: if false; // Admin SDK only
    }

    // ─── Global chat ──────────────────────────────────────────────────────────
    match /chats/{messageId} {
      // Any signed-in user can read and post messages
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Author edits their own message (author fields immutable). Any other
      // signed-in user may update ONLY the "likes" field, to like/unlike it.
      allow update: if request.auth != null && (
        (
          resource.data.userId == request.auth.uid
          && !("userId" in request.resource.data.diff(resource.data).affectedKeys())
        )
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ─── Arsenal marketplace ──────────────────────────────────────────────────
    // Player-to-player listings. Every mutation (list / buy / cancel, the escrow
    // move, fame transfer and status change) runs server-side via the Firebase
    // Admin SDK, which bypasses these rules. Clients are read-only so a buyer
    // can browse, but can never forge a listing, change a price or mark one sold.
    match /marketplace/{listingId} {
      allow read:  if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // ─── Community song section maps ──────────────────────────────────────────
    // Shared YouTube section timings other users can import for the same
    // song+video. Every submission is structurally validated, rate-limited and
    // consensus-recomputed server-side via /api/songs/section-map/submit
    // (Admin SDK) — clients may only read, never write, so the automatic
    // quality gate can't be bypassed.
    match /songSectionMaps/{mapId} {
      allow read:  if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // ─── Challenge nominations ────────────────────────────────────────────────
    // Voting ballot for next month's challenge songs. Any signed-in user may
    // read nominations or vote (modify voters array). Creating/nominating
    // a song or managing carry-over is handled server-side via Admin SDK
    // (/api/challenges/nominate for votes, /api/challenges/ensure-current
    // for carry-over and auto-cleanup of stale nominations).
    match /challengeNominations/{nominationId} {
      allow read:  if request.auth != null;
      allow create: if false; // Admin SDK only
      // Any signed-in user may vote by modifying voters array (voteCount changes with it)
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voters', 'voteCount']);
      allow delete: if false; // Admin SDK only (auto-cleanup via ensure-current)
    }

    // ─── Pending Buy Me a Coffee supporters ───────────────────────────────────
    // Donations whose email has no account yet, parked until that person logs
    // in (/api/bmc-webhook writes, /api/user/getUserData claims — both Admin
    // SDK). These documents hold donor email addresses, so no client may read
    // them, not even the donor.
    match /bmcPendingSupporters/{email} {
      allow read, write: if false; // Admin SDK only
    }

    // ─── Supporter roadmap board ──────────────────────────────────────────────
    // Ideas and the per-user vote allocation behind them. Votes and idea
    // credits are bought with real donations, so every read and write goes
    // through /api/supporter/* (Admin SDK), which re-derives the budget from
    // the user document. A client that could write here would print its own
    // votes.
    match /roadmapIdeas/{ideaId} {
      allow read, write: if false; // Admin SDK only
    }

    match /roadmapVotes/{userId} {
      allow read, write: if false; // Admin SDK only
    }

    // ─── Weekly community goal ────────────────────────────────────────────────
    // The goal itself, and the supporter ballot that picks next week's. Progress
    // is never stored — it is aggregated from practice reports on read — so the
    // only writes are the rollover, a paid ballot vote and the reward claim,
    // all through /api/community-goal/* on the Admin SDK. A client that could
    // write here could hand every player in the app free Fame.
    match /communityGoals/{weekId} {
      allow read, write: if false; // Admin SDK only
    }

    match /communityGoalBallots/{weekId} {
      allow read, write: if false; // Admin SDK only
    }

    // ─── Work board ───────────────────────────────────────────────────────────
    // Queue / in progress / done, maintained by the owner in /admin/work and
    // read by supporters through /api/supporter/work (Admin SDK). Nothing here
    // is client-writable: it is the project's public word on what is happening.
    match /workItems/{itemId} {
      allow read, write: if false; // Admin SDK only
    }

    // ─── Gear proposals ───────────────────────────────────────────────────────
    // Supporter-proposed guitars and pedals, and the token backing behind them.
    // Written only by /api/supporter/gear/* (Admin SDK), which re-validates the
    // rarity, the effect type, the teardown and — the one that matters for
    // anyone else's browser — the image link's scheme.
    match /gearProposals/{proposalId} {
      allow read, write: if false; // Admin SDK only
    }

    match /gearVotes/{userId} {
      allow read, write: if false; // Admin SDK only
    }

    // ─── Supporter case ───────────────────────────────────────────────────────
    // The fortnightly slate and the ballot that picks the next one. Written
    // only by /api/supporter/case/* (Admin SDK) and read back by the draw in
    // /api/arsenal/open-case. A client able to write here could put any item it
    // liked into a 300-Fame case, so nothing below is client-writable.
    match /supporterCaseSlates/{cycleId} {
      allow read, write: if false; // Admin SDK only
    }

    match /supporterCaseBallots/{cycleId} {
      allow read, write: if false; // Admin SDK only
    }

    // ─── Guilds ───────────────────────────────────────────────────────────────
    // A guild's document id is its name and `guildTags/{tag}` is its tag claim,
    // so a client able to write here could take every name in the game, or free
    // one somebody paid tokens for. Founding, joining and leaving all run
    // server-side through /api/supporter/guild/* (Admin SDK).
    match /guilds/{guildId} {
      allow read, write: if false; // Admin SDK only

      // The guild's own chat room. This one IS client-facing: messages arrive
      // over a realtime listener, so members read and write it directly.
      // Membership is checked against the caller's own `guildId`, which only
      // the Admin SDK can set (see the users rule above) — reading the guild's
      // member array here would mean matching objects inside it, which rules
      // cannot do cleanly.
      // Requests to join. Server-only: a client able to write here could seat
      // itself, and one able to read another guild's queue would see who is
      // trying to leave for somewhere else.
      match /applications/{applicantUid} {
        allow read, write: if false; // Admin SDK only
      }

      // The shared shelf and its ledger. Server-only: an entry holds a real
      // gear instance, so a client able to write here could mint items, and one
      // able to edit the log could take without the taking being visible —
      // which is the only thing keeping a free-for-all shelf honest.
      match /stash/{entryId} {
        allow read, write: if false; // Admin SDK only
      }

      match /stashLog/{logId} {
        allow read, write: if false; // Admin SDK only
      }

      match /chat/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.guildId == guildId;

        allow create: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.guildId == guildId
          && request.resource.data.userId == request.auth.uid;

        // Author edits their own message (author fields immutable); any member
        // may touch only "likes" — same shape as the global chat.
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.guildId == guildId
          && (
            (
              resource.data.userId == request.auth.uid
              && !("userId" in request.resource.data.diff(resource.data).affectedKeys())
            )
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          );

        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
    }

    match /guildTags/{tag} {
      allow read, write: if false; // Admin SDK only
    }

    // ─── Default: deny everything else ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
